SPRING_PROFILES_ACTIVE=azure

# BASE DE DATOS AWS RDS (POSTGRESQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://andesstay-db.cri8jc4fzsag.us-east-1.rds.amazonaws.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgressql

# RABBITMQ CLUSTER (HOST EN EC2 #2)
# Reemplaza <IP_EC2_2_NOTIFY> por la IP de la EC2 #2 donde corre ms-andesstay-notify
SPRING_RABBITMQ_HOST=<IP_EC2_2_NOTIFY>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
RABBITMQ_ADDRESSES=<IP_EC2_2_NOTIFY>:5672,<IP_EC2_2_NOTIFY>:5673

# AUTENTICACIÓN AZURE ENTRA ID
AZURE_ISSUER_URI=https://login.microsoftonline.com/35442bb9-6147-4555-8ac7-7aea33ca4c73/v2.0
AZURE_AUDIENCE=api://5bf59bf1-a4c7-4169-975d-8976a17e9b60

# FRONTEND CORS & MICROSERVICIOS ENLACES
# Reemplaza <IP_PUBLICA_EC2_1> por la IP pública o dominio de tu servidor EC2 #1
ANDESSTAY_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://<IP_PUBLICA_EC2_1>
RESERVATIONS_SERVICE_URL=http://ms-andesstay-reservations:8083