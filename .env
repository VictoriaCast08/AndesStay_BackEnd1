# =============================================================================
# AndesStay Backend — Variables de Entorno (Instancia A, EC2)
# =============================================================================
# Rellene los valores reales antes de ejecutar docker compose up
# =============================================================================

# --- Perfil de Spring ---
SPRING_PROFILES_ACTIVE=azure

# --- Instancia A (EC2 donde corre este Backend) ---
EC2_BACKEND_IP=

# --- Instancia B (EC2 externa donde corre RabbitMQ) ---
EC2_RABBITMQ_IP=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

# --- AWS RDS (Base de Datos externa) ---
AWS_DB_HOST=
AWS_DB_PORT=5432
AWS_DB_NAME=
AWS_DB_USER=
AWS_DB_PASS=

# --- Microsoft Entra ID (Azure AD) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- AWS API Gateway y Frontend ---
AWS_API_GATEWAY_URL=
FRONTEND_URL=

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ALLOWED_ORIGINS=
