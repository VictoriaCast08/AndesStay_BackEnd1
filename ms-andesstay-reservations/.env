AZURE_AUDIENCE=api://5bf59bf1-a4c7-4169-975d-8976a17e9b60

# --- FRONTEND CORS ---
# Incluye tanto tu desarrollo local como la IP pública de tu EC2 en AWS
ANDESSTAY_CORS_ORIGINS=http://localhost:4200,http://<IP_PUBLICA_EC2_1>

# --- BASE DE DATOS AWS RDS ---
SPRING_DATASOURCE_URL=jdbc:postgresql://andesstay-db.cri8jc4fzsag.us-east-1.rds.amazonaws.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgressql

# --- RABBITMQ CLUSTER (EC2 #2 - NOTIFY) ---
# Reemplaza <IP_EC2_2_NOTIFY> por la IP de la EC2 donde corre ms-andesstay-notify
SPRING_RABBITMQ_HOST=<IP_EC2_2_NOTIFY>
SPRING_RABBITMQ_PORT=5672
RABBITMQ_HOST_NOTIFY_EC2=<IP_EC2_2_NOTIFY>
RABBITMQ_ADDRESSES=<IP_EC2_2_NOTIFY>:5672,<IP_EC2_2_NOTIFY>:5673
RABBITMQ_USER=guest
RABBITMQ_PASS=guest